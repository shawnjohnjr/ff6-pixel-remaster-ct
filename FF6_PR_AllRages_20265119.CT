local function roster()
 local result={}
 for _,o in ipairs(list(ptr(u+fld(um,'&lt;OwnedCharacterList&gt;k__BackingField').offset),16)) do
  assert(readPointer(o)==cc,'Invalid character object')
  local s=ptr(o+fld(cc,'saveData').offset,cs)
  local id=readInteger(s+fld(cs,'id','System.Int32').offset)
  assert(id and id&gt;=1 and id&lt;=16 and not result[id],'Invalid character ID')
  result[id]={object=o,save=s,id=id,status=readInteger(s+fld(cs,'characterStatusId','System.Int32').offset),job=readInteger(s+fld(cs,'jobId','System.Int32').offset)}
 end
 return result
end
local ac=cls('Last.Data.User','OwnedAbility');local ass=cls('Last.Data.User','OwnedAbilitySaveData')
local function abilityRecords(o)
 local records={}
 for _,v in ipairs(list(ptr(o+fld(cc,'&lt;OwnedAbilityList&gt;k__BackingField').offset),512)) do
  assert(readPointer(v)==ac,'Invalid ability object')
  local s=ptr(v+fld(ac,'saveData').offset,ass)
  local id=readInteger(s+fld(ass,'abilityId','System.Int32').offset)
  local cid=readInteger(s+fld(ass,'contentId','System.Int32').offset)
  local skill=readInteger(s+fld(ass,'skillLevel','System.Int32').offset)
  assert(id and id&gt;0 and cid and cid&gt;0 and skill and not records[id],'Invalid or duplicate ability record')
  records[id]={content=cid,skill=skill}
 end
 return records
end
local function snapshot()
 local result={}
 for id,ch in pairs(roster()) do
  result[id]={status=ch.status,job=ch.job,exp=readInteger(ch.save+fld(cs,'currentExp','System.Int32').offset),abilities=abilityRecords(ch.object),commands=list(ptr(ch.object+fld(cc,'&lt;CommandList&gt;k__BackingField').offset),64)}
 end
 return result
end
local before=snapshot();local target
for id,ch in pairs(roster()) do
 if ch.status==requiredStatus and ch.job==requiredJob then assert(not target,'Duplicate target role');target=ch end
end
assert(target,'ROLE_NOT_READY: '..roleName..' has not joined as a permanent character. No skills were changed.')
local targetId=target.id
local allowed={};for _,v in ipairs(skills) do allowed[v[1]]=v[2] end
local clientClass=cls('Last.Management','OwnedCharacterClient')
local learn=meth(clientClass,'LearningAbility','System.Int32,System.Int32')
local ctor=meth(clientClass,'.ctor','')
local function verify(final)
 local after=snapshot()
 for id,old in pairs(before) do
  local now=assert(after[id],'Character removed')
  assert(now.status==old.status and now.job==old.job and now.exp==old.exp,'Character identity/job/EXP changed')
  assert(#now.commands==#old.commands,'Command count changed')
  for i,v in ipairs(old.commands) do assert(now.commands[i]==v,'Command list changed') end
  for aid,record in pairs(old.abilities) do
   local v=assert(now.abilities[aid],'Existing ability removed')
   assert(v.content==record.content and v.skill==record.skill,'Existing ability record changed')
  end
  for aid,v in pairs(now.abilities) do
   if not old.abilities[aid] then
    assert(id==targetId and allowed[aid]==v.content,'Unexpected new ability')
   end
  end
 end
 if final then
  for _,v in ipairs(skills) do
   local a=assert(after[targetId].abilities[v[1]],'Expected skill missing: '..v[3])
   assert(a.content==v[2],'Content mismatch: '..v[3])
  end
 end
 return after
end
if FF6_SKILL_READ_ONLY then
 print('PREFLIGHT',roleName,targetId,#skills)
 return
end
local client=mono_object_new(clientClass)
assert(type(client)=='number' and client&gt;65536 and readPointer(client)==clientClass,'Cannot create character client')
call(ctor,client)
local added=0
for _,v in ipairs(skills) do
 local current=abilityRecords(assert(roster()[targetId]).object)
 if not current[v[1]] then
  local result=call(learn,client,{targetId,v[1]})
  local updated=abilityRecords(assert(roster()[targetId]).object)
  assert(updated[v[1]] and updated[v[1]].content==v[2],'Learning failed: '..v[3])
  added=added+1
 end
end
verify(true)
print('VERIFIED',roleName,#skills,'skills;',added,'new; original character abilities and commands preserved')

showMessage("技能記錄已核對完成。請重開技能選單確認，另存新欄位。取消勾選不會還原。")
{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
