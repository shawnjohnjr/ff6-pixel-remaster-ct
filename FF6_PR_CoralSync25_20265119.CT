<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"珊瑚碎片＋劇情計數同步設為25；正常餵寶箱，不直接開路 / Set Coral + scenario counter to 25; feed chest normally"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local FF6_BET_ITEMS_READ_ONLY=false
assert(getOpenedProcessID()~=0,'Attach to FINAL FANTASY VI.exe')
local base=getAddressSafe('GameAssembly.dll');assert(base,'GameAssembly.dll missing')
local pe=base+readInteger(base+60)
assert(readInteger(pe+8)==1745316249 and readInteger(pe+80)==42369024,'Requires FF6 PR Steam build 20265119')
assert(LaunchMonoDataCollector(),'Mono collector unavailable')
local classes,fields,methods={},{},{}
local function cls(ns,n)
 local key=ns..'.'..n
 if not classes[key] then local c=mono_findClass(ns,n);assert(c and c~=0,'Class missing: '..key);classes[key]=c end
 return classes[key]
end
local function fld(c,n,t)
 if not fields[c] then fields[c]=assert(mono_class_enumFields(c,true),'Field lookup failed') end
 for _,v in ipairs(fields[c]) do if v.name==n then assert(not t or v.typename==t,'Field type mismatch: '..n);return v end end
 error('Missing field '..n)
end
local function meth(c,n,sig)
 local current=c
 while current and current~=0 do
  if not methods[current] then methods[current]=assert(mono_class_enumMethods(current),'Method lookup failed') end
  for _,m in ipairs(methods[current]) do if m.name==n and mono_method_getSignature(m.method)==sig then return m.method end end
  current=mono_class_getParent(current)
 end
 error('Missing method '..n..' ('..sig..')')
end
local function call(m,o,args)
 local r,e=mono_invoke_method(0,m,o or 0,args or {});assert(e==nil,tostring(e));return r
end
local function ptr(a,c)
 local p=readPointer(a);assert(p and p&gt;65536,'Invalid pointer')
 if c then assert(readPointer(p)==c,'Object type mismatch') end
 return p
end
local function list(o,max)
 local n=readInteger(o+0x18);local a=ptr(o+0x10)
 assert(n and n&gt;=0 and n&lt;=max,'Invalid list count')
 local capacity=readInteger(a+0x18);assert(capacity and capacity&gt;=n and capacity&lt;=512,'Invalid capacity')
 local r={};for i=0,n-1 do r[#r+1]=ptr(a+0x20+i*8) end;return r
end
local um=cls('Last.Management','UserDataManager')
local u=mono_class_getStaticFieldValue(um,fld(um,'instance').field)
assert(type(u)=='number' and u&gt;65536 and readPointer(u)==um,'Load a save first')
local us=cls('Last.Data.User','UserSaveData')
local save=ptr(u+fld(um,'saveData').offset,us)
local cc=cls('Last.Data.User','OwnedCharacterData')
local cs=cls('Last.Data.User','OwnedCharacterSaveData')
local pc=cls('Last.Data','PlayerCharacterParameter')
local chars={}
for _,ch in ipairs(list(ptr(u+fld(um,'&lt;OwnedCharacterList&gt;k__BackingField').offset),512)) do
 assert(readPointer(ch)==cc,'Unexpected character')
 local s=ptr(ch+fld(cc,'saveData').offset,cs)
 local id=readInteger(s+fld(cs,'id','System.Int32').offset)
 assert(id and id&gt;=1 and not chars[id],'Invalid character ID')
 chars[id]={object=ch,save=s,id=id}
end
local corps=cls('Last.Data.User','Corps');local corpsSave=cls('Last.Data.User','CorpsSaveData')
local party={};local seen={}
for _,o in ipairs(list(ptr(u+fld(um,'&lt;corpsList&gt;k__BackingField').offset),4)) do
 assert(readPointer(o)==corps,'Unexpected party slot')
 local s=ptr(o+fld(corps,'saveData').offset,corpsSave)
 local id=readInteger(s+fld(corpsSave,'characterId','System.Int32').offset)
 assert(id and id&gt;=0,'Invalid party ID')
 if id~=0 then assert(chars[id] and not seen[id],'Invalid or repeated party character');seen[id]=true;party[#party+1]=chars[id] end
end
assert(#party&gt;0,'Load a save and stop on the map')


local preserved={}
local function capture(address)
 local n=readInteger(address);assert(n~=nil,'Cannot capture state');preserved[#preserved+1]={address,n}
end
capture(save+fld(us,'owendGil','System.Int32').offset)
local psClass=cls('Last.Data.User','PlayerCharacterParameterSaveData')
for _,ch in pairs(chars) do
 capture(ch.save+fld(cs,'currentExp','System.Int32').offset)
 local p=ptr(ch.object+fld(cc,'parameter').offset,pc)
 local ps=ptr(p+fld(pc,'saveData').offset,psClass)
 for _,name in ipairs({'&lt;BaseLevel&gt;k__BackingField','currentHP','currentMP','&lt;BasePower&gt;k__BackingField','&lt;BaseAgility&gt;k__BackingField','&lt;BaseVitality&gt;k__BackingField','&lt;BaseMagic&gt;k__BackingField'}) do capture(p+fld(pc,name,'System.Int32').offset) end
 for _,name in ipairs({'addtionalPower','addtionalAgility','addtionalVitality','addtionalMagic'}) do
  capture(ps+fld(psClass,name,'System.Int32').offset)
 end
end


for _,ch in pairs(chars) do capture(ch.save+fld(cs,'magicStoneId','System.Int32').offset) end
capture(save+fld(us,'monstersKilledCount','System.Int32').offset)
for _,name in ipairs({'&lt;CurrentAreaType&gt;k__BackingField','&lt;CurrentAreaId&gt;k__BackingField','&lt;CurrentMapId&gt;k__BackingField'}) do capture(u+fld(um,name).offset) end

local function roster()
 local result={}
 for _,o in ipairs(list(ptr(u+fld(um,'&lt;OwnedCharacterList&gt;k__BackingField').offset),512)) do
  assert(readPointer(o)==cc,'Invalid character object')
  local s=ptr(o+fld(cc,'saveData').offset,cs)
  local id=readInteger(s+fld(cs,'id','System.Int32').offset)
  assert(id and id&gt;=1 and not result[id],'Invalid character ID')
  result[id]={object=o,save=s,id=id,status=readInteger(s+fld(cs,'characterStatusId','System.Int32').offset),job=readInteger(s+fld(cs,'jobId','System.Int32').offset)}
 end
 return result
end
local ac=cls('Last.Data.User','OwnedAbility');local ass=cls('Last.Data.User','OwnedAbilitySaveData')
local function abilityRecords(o)
 local records={}
 for _,v in ipairs(list(ptr(o+fld(cc,'&lt;OwnedAbilityList&gt;k__BackingField').offset),512)) do
  assert(readPointer(v)==ac,'Invalid ability object')
  local s=ptr(v+fld(ac,'saveData').offset,ass)
  local id=readInteger(s+fld(ass,'abilityId','System.Int32').offset)
  local cid=readInteger(s+fld(ass,'contentId','System.Int32').offset)
  local skill=readInteger(s+fld(ass,'skillLevel','System.Int32').offset)
  assert(id and id&gt;0 and cid and cid&gt;0 and skill,'Invalid ability record')
  records[#records+1]={id=id,content=cid,skill=skill}
 end
 return records
end
local function snapshot()
 local result={}
 for id,ch in pairs(roster()) do
  result[id]={status=ch.status,job=ch.job,exp=readInteger(ch.save+fld(cs,'currentExp','System.Int32').offset),abilities=abilityRecords(ch.object),commands=list(ptr(ch.object+fld(cc,'&lt;CommandList&gt;k__BackingField').offset),64)}
 end
 return result
end
local function textValue(p)
 if type(p)=='string' then return p end
 assert(type(p)=='number' and p&gt;65536,'Invalid string pointer')
 local n=readInteger(p+16);assert(n and n&gt;=0 and n&lt;=1000000,'Invalid string length')
 return assert(readString(p+20,n*2,true),'Cannot read string')
end
local function readIntList(o,max)
 local n=readInteger(o+24);local a=ptr(o+16);local capacity=readInteger(a+24)
 assert(n and n&gt;=0 and n&lt;=max and capacity and capacity&gt;=n and capacity&lt;=8192,'Invalid integer list')
 local r={};for i=0,n-1 do r[#r+1]=readInteger(a+32+i*4) end;return r
end
local function equalLists(a,b)
 assert(#a==#b,'List size changed');for i,v in ipairs(a) do assert(b[i]==v,'List contents changed') end
end
local function dictionary(o,stringKeys)
 local c=readPointer(o)
 local n=readInteger(o+fld(c,'count','System.Int32').offset)
 local free=readInteger(o+fld(c,'freeCount','System.Int32').offset)
 assert(n and n&gt;=0 and n&lt;=2048 and free and free&gt;=0 and free&lt;=n,'Invalid dictionary count')
 local a=readPointer(o+fld(c,'entries').offset)
 if n==0 then return {},0 end
 assert(a and a&gt;65536,'Dictionary entries missing')
 local capacity=readInteger(a+24);assert(capacity and capacity&gt;=n and capacity&lt;=4096,'Invalid dictionary capacity')
 local result={};local count=0;local stride=stringKeys and 24 or 16
 for i=0,n-1 do
  local e=a+32+i*stride;local hash=readInteger(e)
  if hash and hash&lt;2147483648 then
   local key=stringKeys and textValue(ptr(e+8)) or readInteger(e+8)
   local value=readInteger(e+(stringKeys and 16 or 12))
   assert(key and value and not result[key],'Invalid or duplicate dictionary entry')
   result[key]=value;count=count+1
  end
 end
 assert(count==n-free,'Dictionary entry count mismatch')
 return result,count
end
local characterBefore
local function verifyCharacters()
 local after=snapshot()
 for id,old in pairs(characterBefore) do
  local now=assert(after[id],'Character removed')
  assert(now.status==old.status and now.job==old.job and now.exp==old.exp,'Character identity/job/EXP changed')
  equalLists(old.commands,now.commands)
  for aid,v in pairs(old.abilities) do local a=assert(now.abilities[aid],'Ability removed');assert(a.id==v.id and a.content==v.content and a.skill==v.skill,'Ability changed') end
  for aid in pairs(now.abilities) do assert(old.abilities[aid],'Unexpected new ability') end
 end
 for id in pairs(after) do assert(characterBefore[id],'Unexpected new character') end
 for _,v in ipairs(preserved) do assert(readInteger(v[1])==v[2],'Gil, character parameters, equipped magicite or kill counter changed') end
end



local heldGil=readInteger(save+fld(us,'owendGil','System.Int32').offset)
local lifetimeGil=readInteger(save+fld(us,'totalGil','System.Int32').offset)
assert(heldGil and heldGil&gt;=0 and lifetimeGil and lifetimeGil&gt;=0,'Invalid Gil counters')
capture(save+fld(us,'totalGil','System.Int32').offset)
local mainKills=readInteger(save+fld(us,'monstersKilledCount','System.Int32').offset)
assert(mainKills and mainKills&gt;=0,'Invalid main kill counter')
characterBefore=snapshot()
local bmClass=cls('Last.Management','PictureBookSaveManager')
local bm=mono_class_getStaticFieldValue(bmClass,fld(bmClass,'instance').field)
assert(type(bm)=='number' and bm&gt;65536 and readPointer(bm)==bmClass,'Bestiary unavailable')
local bdClass=cls('Last.Systems.Save','PictureBookSaveData')
local bd=ptr(bm+fld(bmClass,'&lt;SaveData&gt;k__BackingField').offset,bdClass)
local dictAddress=bd+fld(bdClass,'&lt;MonsterDefeats&gt;k__BackingField').offset
local originalDict=ptr(dictAddress);local monsters,count=dictionary(originalDict,false)
local total=readInteger(bd+fld(bdClass,'totalSubjugationCount','System.Int32').offset)
assert(total and total&gt;=0,'Invalid bestiary total')
local sum=0;for _,n in pairs(monsters) do assert(n&gt;=0 and n&lt;2147483648,'Invalid per-monster count');sum=sum+n end
local bookFlags=readIntList(ptr(bd+fld(bdClass,'&lt;ScenarioFlags&gt;k__BackingField').offset),8192)
local dc=cls('Last.Interpreter','DataStorage');local data=call(meth(dc,'get_Instance',''),0)
assert(type(data)=='number' and data&gt;65536 and readPointer(data)==dc,'Map unavailable')
local serialize=meth(dc,'Serialize','')
local mapBefore=textValue(call(serialize,data))
local expectedMap=mapBefore
local getVariable=meth(dc,'Get','Last.Interpreter.DataStorage.Category,System.Int32')
local setVariable=meth(dc,'Set','Last.Interpreter.DataStorage.Category,System.Int32,System.Int32')
local coralCounterBefore=call(getVariable,data,{8,7})
assert(type(coralCounterBefore)=='number' and coralCounterBefore&gt;=0 and coralCounterBefore&lt;=99,'Invalid coral counter')
local replaced=0
local mapAfter=mapBefore:gsub('("global":%[)([^%]]+)(%])',function(prefix,body,suffix)
 local nums={};for v in body:gmatch('[^,]+') do nums[#nums+1]=v end
 assert(#nums==16 and tonumber(nums[8])==coralCounterBefore,'Serialized counter mismatch')
 nums[8]='25';replaced=replaced+1;return prefix..table.concat(nums,',')..suffix
end)
assert(replaced==1,'Cannot identify global counter in serialized state')
print('CORAL COUNTER BEFORE',coralCounterBefore)

local stones=readIntList(ptr(u+fld(um,'&lt;OwnedMagicStoneList&gt;k__BackingField').offset),64)
local steamClass=cls('Last.Management','SteamSDKManager')
local steam=mono_class_getStaticFieldValue(steamClass,fld(steamClass,'instance').field)
assert(type(steam)=='number' and steam&gt;65536 and readPointer(steam)==steamClass,'Steam unavailable')
assert(readBytes(steam+fld(steamClass,'isInitialze','System.Boolean').offset,1)==1,'Steam must be initialized')
local getAchievements=meth(steamClass,'GetAllAchievementsOnPlatform','')
local function achievements() return dictionary(call(getAchievements,steam),true) end
local beforeSteam,beforeCount=achievements();assert(beforeCount==37,'Unexpected achievement count')
local function inventoryQuantities(field)
 local d=ptr(u+fld(um,field or 'normalOwnedItems').offset);local c=readPointer(d)
 local n=readInteger(d+fld(c,'count').offset);local free=readInteger(d+fld(c,'freeCount').offset)
 assert(n and n&gt;=0 and n&lt;=2048 and free and free&gt;=0 and free&lt;=n,'Invalid inventory dictionary')
 if n==0 then return {} end
 local a=ptr(d+fld(c,'entries').offset);local cap=readInteger(a+24);assert(cap and cap&gt;=n and cap&lt;=4096,'Invalid inventory capacity')
 local result={};local count=0
 for i=0,n-1 do
  local e=a+32+i*24;local hash=readInteger(e)
  if hash and hash&lt;2147483648 then
   local id=readInteger(e+8);local item=ptr(e+16)
   assert(id and id&gt;0 and not result[id],'Duplicate or invalid inventory ID')
   local quantity=call(meth(readPointer(item),'get_Count',''),item)
   assert(type(quantity)=='number' and quantity&gt;=0 and quantity&lt;=99,'Invalid inventory quantity')
   result[id]=quantity;count=count+1
  end
 end
 assert(count==n-free,'Inventory record count mismatch');return result
end

local inventoryBefore=inventoryQuantities()
local expectedInventory={};for id,n in pairs(inventoryBefore) do expectedInventory[id]=n end
local importantBefore=inventoryQuantities('importantOwendItems')
local expectedImportant={};for id,n in pairs(importantBefore) do expectedImportant[id]=n end
local function verifyGame()
 local keysNow=inventoryQuantities('importantOwendItems')
 for id,n in pairs(expectedImportant) do assert(keysNow[id]==n,'Important item count changed: '..id) end
 for id in pairs(keysNow) do assert(expectedImportant[id]~=nil,'Important item record added: '..id) end
 local now=inventoryQuantities()
 for id,n in pairs(expectedInventory) do assert(now[id]==n,'Inventory count changed: '..id) end
 for id in pairs(now) do assert(expectedInventory[id]~=nil,'Inventory record added: '..id) end
 assert(readInteger(save+fld(us,'owendGil').offset)==heldGil,'Held Gil changed')
 assert(readInteger(save+fld(us,'totalGil').offset)==lifetimeGil,'Lifetime Gil changed')
 assert(ptr(bm+fld(bmClass,'&lt;SaveData&gt;k__BackingField').offset,bdClass)==bd,'Bestiary save object changed')
 assert(readInteger(save+fld(us,'monstersKilledCount').offset)==mainKills,'Main-save kills changed')
 assert(readInteger(bd+fld(bdClass,'totalSubjugationCount').offset)==total,'Bestiary total changed')
 assert(ptr(dictAddress)==originalDict,'Monster dictionary replaced')
 local now,nowCount=dictionary(originalDict,false);assert(nowCount==count,'Monster record count changed')
 for id,n in pairs(monsters) do assert(now[id]==n,'Individual monster count changed: '..id) end
 equalLists(bookFlags,readIntList(ptr(bd+fld(bdClass,'&lt;ScenarioFlags&gt;k__BackingField').offset),8192))
 assert(textValue(call(serialize,data))==expectedMap,'Map/scenario/treasure state changed')
 equalLists(stones,readIntList(ptr(u+fld(um,'&lt;OwnedMagicStoneList&gt;k__BackingField').offset),64))
 verifyCharacters()
end

local targets={{47,"珊瑚碎片"}}

local itemClientClass=cls('Last.Management','OwnedItemClient')
local ctor=meth(itemClientClass,'.ctor','')
local add=meth(itemClientClass,'AddOwnedItem','System.Int32,System.Int32')
local remove=meth(itemClientClass,'RemoveOwnedItem','System.Int32,System.Int32')
for _,v in ipairs(targets) do v.before=importantBefore[v[1]] or 0;print('ITEM BEFORE',v[1],v[2],v.before) end
verifyGame()
if FF6_BET_ITEMS_READ_ONLY then print('BET ITEMS PREFLIGHT VERIFIED');return end
local function encode(v)
 if type(v)=='number' then return tostring(v) end
 assert(type(v)=='table','Unsupported snapshot type')
 local rows={}
 for k,x in pairs(v) do assert(tostring(k):match('^[a-zA-Z0-9_]+$'),'Invalid snapshot key');rows[#rows+1]='"'..tostring(k)..'":'..encode(x) end
 table.sort(rows);return '{'..table.concat(rows,',')..'}'
end
local folder=FF6_CORAL_BACKUP_DIR or getCheatEngineDir()
assert(type(folder)=='string' and #folder&gt;0,'No backup directory')
if not folder:match('[/\\]$') then folder=folder..'/' end
local backup=folder..'FF6_CoralSync25_before_'..os.date('%Y%m%d_%H%M%S')..'_'..getTickCount()..'.json'
local f=assert(io.open(backup,'wb'),'Cannot create backup')
assert(f:write(encode({inventory=inventoryBefore,coralCounter=coralCounterBefore,importantItems=importantBefore,characters=characterBefore,heldGil=heldGil,lifetimeGil=lifetimeGil,mainKills=mainKills,achievements=beforeSteam})))
f:close();print('BACKUP',backup)
local mf=assert(io.open(backup..'.map.json','wb'));assert(mf:write(mapBefore));mf:close()
verifyGame()
local client
for _,v in ipairs(targets) do
 if v.before~=25 then
  if not client then
   client=mono_object_new(itemClientClass);assert(type(client)=='number' and client&gt;65536 and readPointer(client)==itemClientClass,'Cannot create item client')
   call(ctor,client)
  end
  if v.before&lt;25 then call(add,client,{v[1],25-v.before}) else call(remove,client,{v[1],v.before-25}) end;expectedImportant[v[1]]=25
 end
end
call(setVariable,data,{8,7,25});expectedMap=mapAfter
assert(call(getVariable,data,{8,7})==25,'Coral counter write mismatch')
verifyGame()
print('CORAL COUNTER VERIFIED',coralCounterBefore,'-&gt;',25)
local afterSteam,n=achievements();assert(n==beforeCount,'Achievement count changed')
for k,v in pairs(beforeSteam) do assert(afterSteam[k]==v,'Achievement changed: '..k) end
local after=inventoryQuantities('importantOwendItems')
for _,v in ipairs(targets) do
 assert((after[v[1]] or 0)==25,'Target item quantity mismatch: '..v[2])
 print('ITEM VERIFIED',v[1],v[2],v.before,'-&gt;',after[v[1]])
end
print('BET ITEMS VERIFIED','only coral item and ScenarioVariable[7] changed; all other items, characters, stats, Gil, kills, map fields and achievements unchanged')

showMessage('珊瑚碎片與劇情計數已同步設為 25。請與寶箱對話餵食，再另存新欄位。\nCoral and scenario counter are now 25. Feed the chest normally, then save to a new slot.\nDisabling does not undo this edit.\nBackup: '..backup)

{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
</CheatTable>