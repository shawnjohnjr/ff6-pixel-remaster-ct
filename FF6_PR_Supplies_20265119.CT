local itemClass=cls('Last.Data.User','OwnedItemData')
local search=meth(um,'SearchOwnedItem','System.Int32')
local getCount=meth(itemClass,'get_Count','')
local function quantity(id)
 local o=call(search,u,{id});assert(type(o)=='number','Invalid item response')
 if o==0 then return 0 end
 assert(o&gt;65536 and readPointer(o)==itemClass,'Invalid item object')
 local n=call(getCount,o);assert(type(n)=='number' and n&gt;=0 and n&lt;=99,'Invalid quantity')
 return n
end

local raw=FF6_SUPPLY_TARGET
if raw==nil then
 raw=inputQuery(itemName,'補至多少個？（1–99，現有數量較多會保留）','99')
 if raw==nil then return end
end
local target=tonumber(raw)
assert(target and target==math.floor(target) and target&gt;=1 and target&lt;=99,'Quantity must be an integer from 1 to 99')
local beforeQuantities={}
for _,id in ipairs({7,9,19,23}) do beforeQuantities[id]=quantity(id) end
local before=beforeQuantities[itemId]
local gilAddress=save+fld(us,'owendGil','System.Int32').offset
local gilBefore=readInteger(gilAddress)
local final=math.max(before,target)
if not FF6_SUPPLY_READ_ONLY and final&gt;before then
 local ic=cls('Last.Management','OwnedItemClient')
 local ctor=meth(ic,'.ctor','');local add=meth(ic,'AddOwnedItem','System.Int32,System.Int32')
 local client=mono_object_new(ic)
 assert(type(client)=='number' and client&gt;65536 and readPointer(client)==ic,'Cannot create item client')
 call(ctor,client)
 for id,n in pairs(beforeQuantities) do assert(quantity(id)==n,'Inventory changed; stop on the field map and try again') end
 call(add,client,{itemId,final-before})
end
if not FF6_SUPPLY_READ_ONLY then
 assert(quantity(itemId)==final,'Supply quantity verification failed')
 for id,n in pairs(beforeQuantities) do if id~=itemId then assert(quantity(id)==n,'Other supply quantity changed unexpectedly') end end
 assert(readInteger(gilAddress)==gilBefore,'Gil changed unexpectedly')
 print('SUPPLY VERIFIED',itemId,itemName,before,'-&gt;',final,'Gil preserved',gilBefore)
 if not FF6_SUPPLY_SILENT then showMessage(itemName..'：'..final..'個，已核對。請重開道具選單確認。取消勾選不會還原。') end
else
 print('SUPPLY PREFLIGHT',itemId,itemName,before,'target',target,'Gil',gilBefore)
end

{$asm}
[DISABLE]
</AssemblerScript>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
</CheatTable>